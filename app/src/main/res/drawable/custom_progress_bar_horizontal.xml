<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://android.com">
    
    <!-- Background Track (Unfilled Portion) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <!-- Semi-transparent dark track background -->
            <solid android:color="#2C2C2E" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Progress Indicator (Filled Portion) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- Pure high-contrast iOS system white fill -->
                <solid android:color="#FFFFFF" />
                <corners android:radius="30dp" />
            </shape>
        </clip>
    </item>
    
</layer-list>
