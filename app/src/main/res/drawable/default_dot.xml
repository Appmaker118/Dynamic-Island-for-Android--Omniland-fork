<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://android.com"
    android:shape="rectangle">
    <!-- iOS control system dark background fill -->
    <solid android:color="#2C2C2E" />
    
    <!-- Large corner radius to turn the rectangle corners into squircle capsules -->
    <corners android:radius="14dp" />
    
    <!-- Structural sizing to change dots into wider pill panels -->
    <size 
        android:width="28dp" 
        android:height="40dp" />
</shape>
